# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Admin dashboard password (required to log in at /admin).
# Change this before deploying. If unset, a dev-only default is used and the
# app logs a loud warning.
ADMIN_PASSWORD=change-me-in-production

# Secret used to sign admin session cookies (HMAC). Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-generate-a-long-random-secret

# Path to the SQLite database file. Defaults to ./data/kabootar.db
DATABASE_PATH=./data/kabootar.db

# Moderation policy:
#   false (default) -> auto-approve letters that pass BOTH automated checks (PRD §3)
#   true            -> hold EVERY letter as `pending` for human review (PRD Open Q #2)
REQUIRE_HUMAN_REVIEW=false

# Per-IP submission rate limit (server-side, PRD §5.4).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
